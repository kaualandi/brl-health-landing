# API BRL Health (Elysia). Copie para `.env` (o Bun carrega sozinho).
DATABASE_URL=postgres://brl:brl@localhost:5433/brlhealth
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
PORT=3333
CORS_ORIGIN=http://localhost:3000
APP_TZ=America/Sao_Paulo
# URL pública da API (usada nos links dos GIFs); default http://localhost:PORT.
# PUBLIC_URL=
# Onde ficam os GIFs dos exercícios (default: apps/api/storage/media).
# MEDIA_DIR=
# true só atrás de um reverse proxy confiável (usa x-forwarded-for no rate limit).
# TRUST_PROXY=false
# Opcionais (sem elas: e-mail só loga no console; Stripe responde 501).
# RESEND_API_KEY=
# EMAIL_FROM=BRL Health <nao-responda@exemplo.com>
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
