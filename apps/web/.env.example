# Variáveis de ambiente do BRL Health
# Copie este arquivo para `.env.local` e ajuste os valores conforme o ambiente.
# Ambas têm default seguro para desenvolvimento, então são opcionais localmente.
# Atenção: variáveis NEXT_PUBLIC_* são embutidas no bundle do cliente —
# nunca coloque segredos aqui.

# URL canônica do site, usada pelo SEO (metadata, sitemap, robots, OG).
# Em produção, defina o domínio real (sem barra no final).
NEXT_PUBLIC_SITE_URL=https://brlhealth.com.br

# Base URL da API (Elysia, apps/api). Em dev sobe em http://localhost:3333 e o
# CORS libera http://localhost:3000 (origem do `next dev`) por padrão.
NEXT_PUBLIC_API_URL=http://localhost:3333
