{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "JWT_SECRET", "AUTH_RATE_LIMIT", "APP_TZ"]
    }
  }
}
